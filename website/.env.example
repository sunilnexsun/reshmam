# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.reshmam.com

# ---- Supabase (orders, enquiries, inventory, customer sign-in) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (online payments) ----
# Use test keys (rzp_test_...) until the merchant account is live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard → Webhooks (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ---- Email notifications for enquiries (Resend) ----
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "RESHMAM Website <noreply@reshmam.com>"
ENQUIRY_FROM_EMAIL=
# Where enquiry notifications are delivered
ENQUIRY_TO_EMAIL=info@reshmam.com
