/**
 * Generates supabase/seed.sql from the storefront catalogue so the database
 * mirrors src/app/(storefront)/_lib/products.ts (the single source of truth for products and
 * prices). Run: npm run db:seed:generate
 */
import { writeFileSync } from "node:fs";
import { categories, products } from "../src/app/(storefront)/_lib/products.ts";
import { posts } from "../src/app/(storefront)/_lib/blog.ts";

const q = (v: string | null | undefined) => (v == null ? "null" : `'${v.replace(/'/g, "''")}'`);
const lines: string[] = [
  "-- GENERATED by scripts/generate-seed.mts from src/app/(storefront)/_lib/products.ts and src/app/(storefront)/_lib/blog.ts — do not edit by hand.",
  "-- Prices and stock are PROVISIONAL seed values; confirm with the business.",
  "begin;",
];

categories.forEach((c, i) =>
  lines.push(
    `insert into public.categories (slug, name, description, sort_order) values (${q(c.slug)}, ${q(c.name)}, ${q(c.description)}, ${i})` +
      ` on conflict (slug) do update set name = excluded.name, description = excluded.description, sort_order = excluded.sort_order;`,
  ),
);

for (const p of products) {
  lines.push(
    `insert into public.products (slug, name, short_name, category_slug, kind, branch, edible, summary, image) values (${q(p.slug)}, ${q(p.name)}, ${q(p.shortName)}, ${q(p.category)}, ${q(p.kind)}, ${q(p.branch)}, ${p.edible}, ${q(p.summary)}, ${q(p.image)})` +
      ` on conflict (slug) do update set name = excluded.name, short_name = excluded.short_name, category_slug = excluded.category_slug, kind = excluded.kind, branch = excluded.branch, edible = excluded.edible, summary = excluded.summary, image = excluded.image;`,
  );
  p.variants.forEach((v, i) =>
    lines.push(
      // Stock is only set on first insert so re-running the seed never overwrites live inventory.
      `insert into public.product_variants (id, product_slug, label, price_inr, stock, sort_order) values (${q(v.id)}, ${q(p.slug)}, ${q(v.label)}, ${v.price}, ${v.stock}, ${i})` +
        ` on conflict (id) do update set label = excluded.label, price_inr = excluded.price_inr, sort_order = excluded.sort_order;`,
    ),
  );
}

// Products and variants removed from the catalogue are deactivated (not deleted: past orders refer to them).
const ids = (xs: string[]) => xs.map(q).join(", ");
lines.push(
  `update public.product_variants set active = false where id not in (${ids(products.flatMap((p) => p.variants.map((v) => v.id)))});`,
  `update public.products set active = false where slug not in (${ids(products.map((p) => p.slug))});`,
);

for (const b of posts) {
  lines.push(
    `insert into public.blog_articles (slug, title, category, excerpt, body, image, image_alt, is_sample, published, published_at) values (${q(b.slug)}, ${q(b.title)}, ${q(b.category)}, ${q(b.excerpt)}, ${q(JSON.stringify(b.body))}::jsonb, ${q(b.image)}, ${q(b.imageAlt)}, ${b.sample}, true, ${q(b.date)})` +
      ` on conflict (slug) do nothing;`,
  );
}

lines.push("commit;", "");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n"));
console.log(`Wrote supabase/seed.sql (${products.length} products, ${products.reduce((n, p) => n + p.variants.length, 0)} variants).`);
