rules_version = '2';

// RESHMAM Storage rules: anyone can view images; only staff whose role manages the matching module can
// upload or delete them (roles as in firestore.rules: adminUsers/{uid} + configs/settings.roles).
service firebase.storage {
  match /b/{bucket}/o {

    function isUnderMaxSize() {
      return request.resource.size <= 2 * 1024 * 1024;
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function staffDoc() {
      return firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid));
    }

    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
        && staffDoc().data.status == 'Active';
    }

    function canManage(module) {
      return isStaff() && (
        staffDoc().data.role == 'Admin'
        || firestore.get(/databases/(default)/documents/configs/settings).data.get('roles', {})
             .get(staffDoc().data.role, {}).get('permissions', {}).get(module, 'none') == 'manage'
      );
    }

    function canUpload(module) {
      return canManage(module) && isValidImageType() && isUnderMaxSize();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if canUpload('products');
      allow delete: if canManage('products');
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow create, update: if canUpload('categories');
      allow delete: if canManage('categories');
    }

    match /brands/{allPaths=**} {
      allow read: if true;
      allow create, update: if canUpload('brands');
      allow delete: if canManage('brands');
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow create, update: if canUpload('marketing');
      allow delete: if canManage('marketing');
    }

    match /blogs/{allPaths=**} {
      allow read: if true;
      allow create, update: if canUpload('marketing');
      allow delete: if canManage('marketing');
    }

    match /testimonials/{allPaths=**} {
      allow read: if true;
      allow create, update: if canUpload('marketing');
      allow delete: if canManage('marketing');
    }

    // Staff profile pictures: any active staff member.
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isValidImageType() && isUnderMaxSize();
      allow delete: if isStaff();
    }
  }
}
