# Copy to .env.local and fill in. Never commit real secrets.

# Set these BEFORE `npm run build`: the NEXT_PUBLIC_* values and the security headers are fixed at build time.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.reshmam.com

# The admin panel (/admin) is a browser-only demo with sample logins until it is connected to Supabase Auth.
# Set to 1 to hide it (404) on a production server, e.g. on the public site.
DISABLE_ADMIN_DEMO=

# ---- Supabase (orders, enquiries, inventory, customer sign-in) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (online payments) ----
# Use test keys (rzp_test_...) until the merchant account is live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard → Webhooks (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# ---- Email notifications for enquiries (Resend) ----
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "RESHMAM Website <noreply@reshmam.com>"
ENQUIRY_FROM_EMAIL=
# Where enquiry notifications are delivered
ENQUIRY_TO_EMAIL=info.peekaesons@gmail.com
