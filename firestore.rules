rules_version = '2';

// RESHMAM Firestore rules.
//
// Two kinds of signed-in users:
//  - Customers: Firebase email/password sign-in, with a username or an email (a username signs in as
//    <username>@customers.reshmam.com). They can read and edit only their own profile (limited fields)
//    and read only their own orders. They are never in adminUsers, so they get no staff rights.
//  - Staff: Firebase email/password sign-in, with a record at adminUsers/{uid}. Each staff role's
//    permissions (configs/settings.roles[role].permissions[module] = none | view | manage) are enforced
//    here. The Admin role always has full access, so it can't be locked out.
//
// Server routes use the Admin SDK, which bypasses these rules and enforces the same table in code
// (src/lib/staff-permissions.ts). Orders are created only by the server.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staffPath() {
      return /databases/$(database)/documents/adminUsers/$(request.auth.uid);
    }

    function isStaff() {
      return signedIn() && exists(staffPath()) && get(staffPath()).data.status == 'Active';
    }

    function staffRole() {
      return get(staffPath()).data.role;
    }

    function isAdminRole() {
      return isStaff() && staffRole() == 'Admin';
    }

    // The caller's level for a module: 'none' | 'view' | 'manage'.
    function level(module) {
      return isAdminRole()
        ? 'manage'
        : get(/databases/$(database)/documents/configs/settings).data.get('roles', {})
            .get(staffRole(), {}).get('permissions', {}).get(module, 'none');
    }

    function canView(module) {
      return isStaff() && level(module) in ['view', 'manage'];
    }

    function canManage(module) {
      return isStaff() && level(module) == 'manage';
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------------------------------------------------------------------------------------------
    // Catalogue and storefront content: public read, staff write by module.
    // ---------------------------------------------------------------------------------------------
    match /products/{id} {
      allow read: if true;
      allow write: if canManage('products');
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if canManage('categories');
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if canManage('brands');
    }

    match /branches/{id} {
      allow read: if true;
      allow write: if canManage('branches');
    }

    // Price and stock both live on variants, so updates are checked field by field.
    match /variants/{id} {
      allow read: if true;
      allow create, delete: if canManage('products');
      allow update: if canManage('products')
        || (canManage('prices') && changedOnly(['price', 'mrp', 'updatedAt']))
        || (canManage('inventory') && changedOnly(['stock', 'alertStock', 'updatedAt']));
    }

    match /coupons/{id} {
      allow read: if true; // checkout validates coupon codes
      allow write: if canManage('marketing');
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if canManage('marketing');
    }

    match /blogs/{id} {
      allow read: if true;
      allow write: if canManage('marketing');
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if canManage('marketing');
    }

    match /campaigns/{id} {
      allow read: if canView('marketing');
      allow write: if canManage('marketing');
    }

    match /priceHistory/{id} {
      allow read: if canView('prices');
      allow write: if canManage('prices');
    }

    match /stockMovements/{id} {
      allow read: if canView('inventory');
      allow write: if canManage('inventory');
    }

    match /activities/{id} {
      allow read: if canView('dashboard');
      allow create: if isStaff();
    }

    // ---------------------------------------------------------------------------------------------
    // Orders: created only by the server (Admin SDK). A customer reads their own.
    // ---------------------------------------------------------------------------------------------
    match /orders/{id} {
      allow read: if canView('orders') || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if canManage('orders');
    }

    // ---------------------------------------------------------------------------------------------
    // Customers: a customer's own profile at customers/{their uid}.
    // ---------------------------------------------------------------------------------------------
    match /customers/{customerId} {
      function isOwner() {
        return signedIn() && request.auth.uid == customerId;
      }

      allow read: if isOwner() || canView('customers');

      // The profile's username or email must be the one this account signs in with (so nobody can claim
      // someone else's). The mobile number is as typed: an Indian mobile in E.164 form.
      function signsInAs(data) {
        return data.username is string && data.email is string
          && (data.username != ''
            ? request.auth.token.email == data.username + '@customers.reshmam.com'
            : request.auth.token.email == data.email && !data.email.matches('.*@customers[.]reshmam[.]com'));
      }

      allow create: if canManage('customers') || (
        isOwner()
        && request.resource.data.keys().hasOnly(
          ['id', 'name', 'username', 'email', 'phone', 'createdAt', 'updatedAt', 'source', 'cart', 'wishlist'])
        && request.resource.data.id == customerId
        && signsInAs(request.resource.data)
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('[+]91[6-9][0-9]{9}')
        && request.resource.data.source == 'website'
        && request.resource.data.name is string
      );

      allow update: if canManage('customers')
        || (isOwner() && changedOnly(['name', 'email', 'cart', 'wishlist', 'updatedAt']));

      allow delete: if canManage('customers');
    }

    // ---------------------------------------------------------------------------------------------
    // Staff and admin configuration.
    // ---------------------------------------------------------------------------------------------
    match /adminUsers/{uid} {
      allow read: if (isStaff() && request.auth.uid == uid) || canView('settings');
      allow write: if isAdminRole();
    }

    match /configs/{docId} {
      allow read: if (docId == 'settings' && canView('settings'))
        || (docId == 'whatsapp' && canView('whatsapp'))
        || (docId == 'chatbot' && canView('chatbot'));
      allow write: if (docId == 'settings' && isAdminRole())
        || (docId == 'whatsapp' && canManage('whatsapp'))
        || (docId == 'chatbot' && canManage('chatbot'));
    }
  }
}
