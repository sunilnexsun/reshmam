rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated();
      // Optional: check admin claim if custom claims are used:
      // return isAuthenticated() && request.auth.token.admin == true;
    }

    // -------------------------------------------------------------
    // Products & Variants (Public read active, Admin manage all)
    // -------------------------------------------------------------
    match /products/{productId} {
      allow read: if true; // Public can read products for storefront
      allow write: if isAdmin(); // Only admins can add, edit, or delete
    }

    match /variants/{variantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // Categories & Brands (Public read, Admin manage all)
    // -------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // Orders (Public can create orders, Admin manages all)
    // -------------------------------------------------------------
    match /orders/{orderId} {
      // Customers can create an order at checkout
      allow create: if true;
      // Admins can read, update status, and manage all orders
      // Customers can read their own order if customerId or auth matches
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Customers (Customer can read/edit own profile, Admin manages all)
    // -------------------------------------------------------------
    match /customers/{customerId} {
      allow create: if true;
      allow read, update: if isAdmin() || (isAuthenticated() && request.auth.uid == customerId);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Branches, Price History, Stock Movements, Reports & Audits
    // -------------------------------------------------------------
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /priceHistory/{historyId} {
      allow read, write: if isAdmin();
    }

    match /stockMovements/{movementId} {
      allow read, write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // Marketing (Coupons, Campaigns, Banners)
    // -------------------------------------------------------------
    match /coupons/{couponId} {
      allow read: if true; // Storefront needs to validate coupons
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // System Settings & Integrations (WhatsApp, Chatbot, Roles)
    // -------------------------------------------------------------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /whatsapp/{docId} {
      allow read, write: if isAdmin();
    }

    match /chatbot/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
